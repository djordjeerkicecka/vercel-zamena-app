# Add these SERVER-ONLY variables to the existing environment; retain the existing
# Shopify Client ID/Secret and Supabase variables. Never use NEXT_PUBLIC_ for tokens.
SHOPIFY_AUTH_MODE=oauth
SHOPIFY_APP_URL=https://vercel-zamena-app.vercel.app
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# The canonical Shopify hostname, with no protocol or path:
SHOPIFY_STORE_DOMAIN=e5uh9b-rn.myshopify.com

# Optional second store: set its mode independently. Existing stores default to
# client_credentials when their mode is unset.
# SHOPIFY_AUTH_MODE_2=oauth
